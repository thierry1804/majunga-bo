{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as m %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}
{% block preheader %}Choisissez un nouveau mot de passe. Ce lien est valable 1 heure.{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-size:28px;line-height:32px;font-weight:bold;letter-spacing:-0.5px;color:#2a2520;">Choisissez un nouveau mot de passe</h1>
    <p style="margin:0 0 20px 0;">Bonjour,</p>
    <p style="margin:0 0 20px 0;">Vous avez demandé la réinitialisation du mot de passe de votre compte MadaBooking. Cliquez sur le bouton pour en choisir un nouveau. Ce lien est valable <strong>1 heure</strong>.</p>

    {{ m.button(resetUrl, 'Réinitialiser mon mot de passe') }}

    <p style="margin:0 0 8px 0;font-size:13px;color:#5c5349;">Le bouton ne fonctionne pas ? Copiez ce lien dans votre navigateur :</p>
    <p style="margin:0 0 20px 0;font-size:13px;word-break:break-all;"><a href="{{ resetUrl }}" style="color:#145555;">{{ resetUrl }}</a></p>

    <p style="margin:0 0 24px 0;padding:14px 16px;background-color:#f5ede0;border-radius:10px;font-size:13px;line-height:20px;color:#5c5349;">Vous n'êtes pas à l'origine de cette demande ? Ignorez ce message : votre mot de passe actuel reste valable.</p>
{% endblock %}

{% block footnote %}Pour votre sécurité, ne transférez jamais ce message.{% endblock %}
